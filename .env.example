# Railway Postgres. Copy from the Postgres service → Variables tab.
# Use DATABASE_URL (private network) for services deployed on Railway, and
# DATABASE_PUBLIC_URL when connecting from your laptop.
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Signs the session cookie. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Used by the /api/generate/* routes.
OPENAI_API_KEY=sk-...
